# ArcLens starts in build-no-key mode when this is omitted.
ARCLENS_MODE=build-no-key

# Required only for live-local. Hosted modes fail closed in this assessment build.
ANTHROPIC_API_KEY=

# Safe overrides. See docs/developer-experience.md.
CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_EFFORT=high
ARCLENS_MAX_BUDGET_USD=0.75
ARCLENS_LOG_LEVEL=info

# Reserved for future hosted controls; these do not enable hosted mode in v0.1.
ARCLENS_SESSION_SECRET=
ARCLENS_ADMIN_TOKEN=
